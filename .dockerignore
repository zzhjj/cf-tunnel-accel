!ui/static/index.html
!ui/static/style.css
!docker/
!docker/healthcheck.py

# Keep source-control, local state, credentials, tests, and documentation out of context.
.git/
.gitignore
.env
.env.*
**/.env
**/.env.*
**/state/
**/tests/
**/*token*
**/*secret*
**/*credential*
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx
**/config/
**/data/
