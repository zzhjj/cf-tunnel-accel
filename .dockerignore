# Deny by default: the image context must contain only the runtime allowlist.
**

# Runtime application files copied by Dockerfile.
!LICENSE
!cf-tunnel-accel
!cfa_config.py
!cfa_cdn.py
!cfa_ingress.py
!ui/
!ui/server.py
!ui/profiles.py
!ui/static/
