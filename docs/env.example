# cf-tunnel-accel local configuration TEMPLATE; not ready to use unchanged.
# Default: ${XDG_CONFIG_HOME:-$HOME/.config}/cf-tunnel-accel/env
# Select another file with CF_TUNNEL_ACCEL_ENV_FILE=/absolute/path/env.
# This file is KEY=VALUE data, NOT shell: no export, sourcing or $VAR expansion.
# Replace every <YOUR_...> and example hostname/path before selecting this file.
# Use real absolute paths for your runtime user; directory 0700, files 0600.
# Minimal first run: `cf-tunnel-accel init` (only asks for the auxiliary zone).
# Non-interactive: init --non-interactive --aux-zone example.org --service cloudflared.service.
# This full template is for custom deployments; not every field is required initially.
# init writes local config only; it does not provision Cloudflare or start a service.

# Your existing Tunnel and the exact config/service to manage.
CF_TUNNEL_ACCEL_TUNNEL_ID=<YOUR_TUNNEL_UUID>
CF_TUNNEL_ACCEL_TUNNEL_NAME=alpha
CF_TUNNEL_ACCEL_CONFIG=/absolute/path/to/config-alpha.yml
CF_TUNNEL_ACCEL_SERVICE=cloudflared-alpha.service

# Your active auxiliary zone with SaaS already enabled. This is the one required choice.
# ACCOUNT_ID and AUX_ZONE_ID are optional: omitted, they resolve from the token's scope.
# Set them explicitly for a multi-account deployment or stricter pre-write checks.
CF_TUNNEL_ACCEL_AUX_ZONE=example.org
# CF_TUNNEL_ACCEL_ACCOUNT_ID=<YOUR_ACCOUNT_ID>
# CF_TUNNEL_ACCEL_AUX_ZONE_ID=<YOUR_AUX_ZONE_ID>

# Only a path is stored here; place your API Token in a separate 0600 file.
# Aux zone: Zone:Read + DNS:Edit + SSL and Certificates:Edit.
# Business zones managed automatically: Zone:Read + DNS:Edit, scoped to those zones.
# Existing Tunnel use does not itself require account-wide Tunnel edit permission.
CF_TUNNEL_ACCEL_TOKEN_FILE=/absolute/path/to/private/cloudflare-token
# Normal CLI: process credential group wins over the file credential group.
# Group order: CF_TUNNEL_ACCEL_API_TOKEN, CF_API_TOKEN, CLOUDFLARE_API_TOKEN, then TOKEN_FILE.
# Do not leave an unintended inherited inline Token that overrides your file.
# Registry profiles explicitly choosing credentials replace inherited aliases as a group.

# DNS-only preferred entry; targets are examples, not a guaranteed public service.
CF_TUNNEL_ACCEL_PREFERRED_ENTRY=cdn.example.org
CF_TUNNEL_ACCEL_PREFERRED_TARGET=edge.example.net
CF_TUNNEL_ACCEL_CDN_CANDIDATES=edge.example.net,edge-two.example.net

# Existing business hostname served through this auxiliary zone, with valid TLS.
# Auto best: >=2 healthy business HTTPS samples and >=80% success.
# No probe => network-only; force skips hysteresis only, never business validity.
# Auto verifies the post-change business route and reports bounded rollback results.
CF_TUNNEL_ACCEL_PROBE_HOSTNAME=app.example.net
CF_TUNNEL_ACCEL_CDN_MIN_IMPROVEMENT=15

# Proxied origin CNAME routes to your existing Tunnel; SaaS fallback is zone-wide.
CF_TUNNEL_ACCEL_FALLBACK_ORIGIN=origin.example.org
# Optional per-Tunnel custom origin, recommended when sharing one auxiliary zone.
# Confirm this Cloudflare feature and plan match your deployment before setting it.
# CF_TUNNEL_ACCEL_CUSTOM_ORIGIN=origin-alpha.example.org
# Do not enable ALLOW_ORIGIN_TAKEOVER during a normal install/upgrade.
# Final ingress catch-all, not an implicit business backend.
CF_TUNNEL_ACCEL_FALLBACK_SERVICE=http_status:404

# Use separate cache paths per account/profile; default cache is scope-validated.
CF_TUNNEL_ACCEL_ZONE_CACHE=/absolute/path/to/private/alpha/zones.json
CF_TUNNEL_ACCEL_ZONE_CACHE_TTL=21600
# Optional overrides; keep shared-resource writers coordinated by their lock design.
# CF_TUNNEL_ACCEL_LOCK=/absolute/path/to/private/mutation.lock
# CF_TUNNEL_ACCEL_CLOUDFLARED=/absolute/path/to/cloudflared
# CF_TUNNEL_ACCEL_UI_DIR=/absolute/path/to/private/ui-state
# CF_TUNNEL_ACCEL_UI_PROFILES=/absolute/path/to/profiles.json

# See DEPLOYMENT.md for precedence, profiles, origin ownership and schedule setup.
# Old root installs: preserve ALL your own account/zone/Tunnel/config/service/origin
# selections in private configuration BEFORE upgrade; never depend on old constants.
# Public network behavior is uncertain; bounded rollback is not a cloud transaction.
