[Unit]
Description=cf-tunnel-accel web console (ARC)
Documentation=https://github.com/zzhjj/cf-tunnel-accel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 只依赖标准库；--host 0.0.0.0 让局域网可用，凭据门（token + 锁定 + 审计）是唯一门槛。
# 只想本机用就把 --host 改成 127.0.0.1。
ExecStart=/usr/bin/python3 -u @UI_DIR@/server.py --host 0.0.0.0 --port 8642
Restart=always
RestartSec=3s
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
