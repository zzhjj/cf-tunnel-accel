def _confirm_hostname_choice(host: str, zone_id: str) -> Optional[str]:
    """创建 CNAME 会清掉同名其它类型记录，覆盖前先让用户确认。"""
    if not zone_id:
        return host
    try:
        recs = list_dns(zone_id, host)
    except Exception as exc:
        cprint(f"警告: 读取 {host} 现有解析失败: {exc}", "yellow")
        return host
    if not recs:
        return host
    cprint(f"注意: {host} 已有解析记录，新增加速会用 CNAME 覆盖同名的 A/AAAA 等记录:", "yellow")
    for r in recs:
        cprint(
            f"  - {str(r.get('type')):6s} {r.get('name')} -> {r.get('content')}"
            f" proxied={r.get('proxied')}",
            "yellow",
        )
    return host if prompt_yes_no(f"确认用 {host} 覆盖以上记录？", False) else None


def _pick_subdomain(zone_name: str) -> Optional[str]:
    """在指定 zone 里挑一个子域名，列出已用主机名避免撞车。"""
    meta = _zone_info.get(zone_name) or {}
    zid = str(meta.get("id") or _zone_cache.get(zone_name) or "")
    existing: Dict[str, str] = {}
    for host, service in tunnel_routes():
        if zone_of_host(host) == zone_name:
            existing[host] = service
    try:
        for item in list_custom_hostnames():
            host = str(item.get("hostname") or "").lower()
            if zone_of_host(host) == zone_name:
                existing.setdefault(
                    host,
                    "SaaS status=%s ssl=%s"
                    % (item.get("status"), (item.get("ssl") or {}).get("status")),
                )
    except Exception as exc:
        cprint(f"警告: 读取 SaaS 主机名失败: {exc}", "yellow")

    cprint(f"\n已选 zone: {zone_name}", "bold")
    if existing:
        cprint(f"该 zone 已在用的主机名（{len(existing)} 个）:", "cyan")
        for host in sorted(existing):
            cprint(f"  - {host:<34} {existing[host]}")
    else:
        cprint("该 zone 还没有加速中的主机名。", "cyan")
    labels = {host.split(".")[0] for host in existing}
    hints = [f"{prefix}.{zone_name}" for prefix in HOSTNAME_HINTS if prefix not in labels]
    if hints:
        cprint(f"可用示例: {', '.join(hints[:5])}", "cyan")
    while True:
        tip = hints[0] if hints else f"app.{zone_name}"
        raw_line = read_line(f"子域名（@ = 根域名，回车取消，例如 {tip}）: ")
        if raw_line is None:
            return None
        raw = raw_line.strip().lower().strip(".")
        if not raw:
            return None
        if raw in ("@", zone_name):
            host = zone_name
        elif raw.endswith("." + zone_name):
            host = raw
        else:
            host = f"{raw}.{zone_name}"
        if not HOST_RE.match(host):
            cprint(f"域名格式不正确: {host}", "yellow")
            continue
        if host in existing:
            cprint(f"{host} 已经在用（{existing[host]}）；换个前缀，或先 del 再新增。", "yellow")
            continue
        return _confirm_hostname_choice(host, zid)


def choose_hostname_interactive(query: str = "") -> Optional[str]:
    """从账号内的 zone 列表里挑域名；query 可以是 zone 名、完整域名或子域前缀。"""
    wanted = str(query).strip().lower().rstrip(".")
    pending_label = ""
    if wanted:
        if HOST_RE.match(wanted):
            zone_name = zone_of_host(wanted)
            if zone_name is None:
                try:
                    ensure_zone_cache()
                except Exception:
                    pass
                zone_name = zone_of_host(wanted)
            if zone_name == wanted:
                return _pick_subdomain(zone_name)
            if zone_name:
                return _confirm_hostname_choice(wanted, _zone_cache.get(zone_name, ""))
            cprint(f"{wanted} 不在本账号任何 zone 下（自动配置需要本账号 DNS 权限）。", "yellow")
            if prompt_yes_no("按手动 DNS 模式继续（稍后自己加解析）？", False):
                return wanted
            return None
        pending_label = wanted.split(".")[-1]

    rows = build_zone_inventory(refresh=True, with_dns=False)
    if not rows:
        raise CFError("账号里没有读到任何 zone，请检查 Token 权限（需要 Zone:Read）")
    cprint("\n选择业务域名所属 zone:", "bold")
    numbered: List[dict] = []
    for r in rows:
        if not r["usable"]:
            cprint(f"   --  {r['name']:<26} ✗ {'；'.join(r['reasons'])}", "red")
            continue
        numbered.append(r)
        tag = "辅助域" if r["is_aux"] else "业务域"
        used = f"已用 {len(r['hostnames'])}" if r["hostnames"] else "未使用"
        cprint(f"  {len(numbered):<3} {r['name']:<26} {tag}  {used}")
    cprint("   0   取消（也可以直接输入完整域名）")
    raw_line = read_line("输入序号或域名: ")
    if raw_line is None:
        return None
    raw = raw_line.strip()
    if not raw or raw == "0":
        return None
    if raw.isdigit():
        idx = int(raw)
        if not (1 <= idx <= len(numbered)):
            cprint("序号超出范围", "yellow")
            return None
        zone_name = numbered[idx - 1]["name"]
    else:
        return choose_hostname_interactive(raw)
    if pending_label:
        host = f"{pending_label}.{zone_name}"
        return _confirm_hostname_choice(host, _zone_cache.get(zone_name, ""))
    return _pick_subdomain(zone_name)


