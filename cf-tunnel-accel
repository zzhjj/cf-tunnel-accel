def apply_saas_validation_records(hostname: str, ch: dict, zone_id: Optional[str]) -> None:
    """把 SaaS 验证记录写进业务域名所在 zone。

    zone_id 为 None 表示域名不在本账号（--external 模式），此时只列出手工记录。
    """
    records: List[Tuple[str, str, str]] = []  # (type, name, value)
    own = ch.get("ownership_verification") or {}
    if own.get("name") and own.get("value"):
        records.append(("TXT", own["name"], own["value"]))
    ssl = ch.get("ssl") or {}
    dcv = ssl.get("dcv_delegation_records") or []
    if dcv:
        for d in dcv:
            records.append((d.get("type", "CNAME"), d["cname"], d["cname_target"]))
    else:
        for v in ssl.get("validation_records") or []:
            if v.get("txt_name") and v.get("txt_value"):
                records.append(("TXT", v["txt_name"], v["txt_value"]))
            if v.get("cname") and v.get("cname_target"):
                records.append(("CNAME", v["cname"], v["cname_target"]))
    if not records:
        return
    if not zone_id:
        cprint(f"\n{hostname} 不在本账号，需要在域名 DNS 处手动添加以下验证记录:", "yellow")
        for rtype, name, value in records:
            cprint(f"  {rtype:5s} {name} -> {value}", "yellow")
        return
    for rtype, name, value in records:
        if rtype == "TXT":
            upsert_dns(zone_id, "TXT", name, value, ttl=120)
            cprint(f"已写 {rtype}: {name}", "cyan")
        else:
            upsert_dns(zone_id, rtype, name, value, proxied=False, ttl=120)
            cprint(f"已写 {rtype}: {name} -> {value}", "cyan")


def wait_custom_hostname_active(chid: str, timeout: int = 420, zone_id: Optional[str] = None, hostname: Optional[str] = None) -> dict:
    """等待 SaaS 主机名+证书就绪。

    关键修复：创建后立刻拉状态时，DCV/ACME 记录可能还没生成；
    因此在等待循环里持续补写 ownership / DCV / ACME 验证记录。
    """
    start = time.time()
    last: dict = {}
    applied_keys = set()
    while time.time() - start < timeout:
        last = refresh_custom_hostname(chid)
        status = last.get("status")
        ssl = last.get("ssl") or {}
        ssl_status = ssl.get("status")
        errs = last.get("verification_errors") or []
        cprint(f"  状态: hostname={status}, ssl={ssl_status}, errors={errs}", "blue")

        # 持续补验证记录（尤其是刚创建时还没有 dcv 的情况）
        if zone_id:
            try:
                # ownership
                own = last.get("ownership_verification") or {}
                if own.get("name") and own.get("value"):
                    key = f"own:{own['name']}:{own['value']}"
                    if key not in applied_keys:
                        upsert_dns(zone_id, "TXT", own["name"], own["value"], ttl=120)
                        applied_keys.add(key)
                        cprint(f"  补写 ownership: {own['name']}", "cyan")
                # DCV CNAME 优先
                dcv = ssl.get("dcv_delegation_records") or []
                if dcv:
                    for d in dcv:
                        key = f"dcv:{d.get('cname')}:{d.get('cname_target')}"
                        if key not in applied_keys:
                            upsert_dns(
                                zone_id,
                                d.get("type", "CNAME"),
                                d["cname"],
                                d["cname_target"],
                                proxied=False,
                                ttl=120,
                            )
                            applied_keys.add(key)
                            cprint(f"  补写 DCV: {d['cname']} -> {d['cname_target']}", "cyan")
                else:
                    # 回退 TXT 验证
                    for v in ssl.get("validation_records") or []:
                        if v.get("txt_name") and v.get("txt_value"):
                            key = f"txt:{v['txt_name']}:{v['txt_value']}"
                            if key not in applied_keys:
                                upsert_dns(zone_id, "TXT", v["txt_name"], v["txt_value"], ttl=120)
                                applied_keys.add(key)
                                cprint(f"  补写 ACME TXT: {v['txt_name']}", "cyan")
                    # 部分返回顶层 txt_name/txt_value
                    if ssl.get("txt_name") and ssl.get("txt_value"):
                        key = f"txt:{ssl['txt_name']}:{ssl['txt_value']}"
                        if key not in applied_keys:
                            upsert_dns(zone_id, "TXT", ssl["txt_name"], ssl["txt_value"], ttl=120)
                            applied_keys.add(key)
                            cprint(f"  补写 ACME TXT: {ssl['txt_name']}", "cyan")
            except Exception as e:
                cprint(f"  补写验证记录时警告: {e}", "yellow")

        if status == "active" and ssl_status in (
            "active",
            "pending_issuance",
            "pending_deployment",
        ):
            if ssl_status == "active":
                return last
            # 证书签发中，稍等更稳
            if time.time() - start > 45:
                return last
        time.sleep(10)
    raise CFError(
        "等待自定义主机名/证书 Active 超时。"
        f" hostname={last.get('status')} ssl={(last.get('ssl') or {}).get('status')} detail={last}"
    )


