def get_current_preferred_target(strict: bool = False) -> str:
    """读取 cdn 入口当前 CNAME 目标。

    strict=True 用于可能产生写操作的路径：API 读取失败时中止，避免以默认值
    覆盖已经生效的优选目标；展示用途可维持历史兼容，退回静态默认值。
    """
    try:
        recs = list_dns(AUX_ZONE_ID, PREFERRED_ENTRY)
        for r in recs:
            if r.get('type') == 'CNAME' and r.get('content'):
                return r['content'].rstrip('.')
    except Exception:
        if strict:
            raise
        return PREFERRED_TARGET
    if strict:
        # “没有记录”与“读取 API 失败”不同：首次初始化时应允许创建默认入口，
        # 但网络/API 异常绝不能静默覆盖已有目标。
        return PREFERRED_TARGET
    return PREFERRED_TARGET



def get_dns_record(zone_id: str, name: str, rtype: str = "CNAME") -> Optional[dict]:
    """从 Cloudflare API 读取一条记录（避免本地 DNS 缓存误判）。"""
    for r in list_dns(zone_id, name):
        if r.get("type") == rtype:
            return r
    return None


def get_dns_record_content(zone_id: str, name: str, rtype: str = "CNAME") -> Optional[str]:
    record = get_dns_record(zone_id, name, rtype)
    if record and record.get("content"):
        return str(record["content"]).rstrip(".")
    return None


def wait_dns_cname(zone_id: str, name: str, expect: str, timeout: int = 90) -> str:
    """轮询 API，直到 CNAME 变成期望值。"""
    expect = expect.rstrip(".")
    start = time.time()
    last = ""
    while time.time() - start < timeout:
        last = get_dns_record_content(zone_id, name, "CNAME") or ""
        if last == expect:
            return last
        time.sleep(2)
    raise CFError(f"等待 DNS CNAME 生效超时: {name} 当前={last or '(空)'} 期望={expect}")


def probe_local_backend(
    service_url: str, timeout: int = 5, host_header: Optional[str] = None
) -> Tuple[bool, str]:
    """探测本地后端，返回 (是否可用, 简短原因)。

    先发一个 HEAD；任何 HTTP 状态码都说明服务端口和 HTTP 栈在线，失败时
    再回退 TCP。相比 HEAD+GET 双请求，这样不会在新增/批量诊断时放大业务流量。
    """
    if service_url.startswith("http_status:"):
        return True, service_url
    url = service_url if service_url.endswith("/") else service_url + "/"
    last_err = ""
    headers = {"User-Agent": f"cf-tunnel-accel/{SCRIPT_VERSION}/health"}
    # 本地反向代理常依据 Host 路由；保留原始业务域名才能测到真实 ingress。
    if host_header:
        headers["Host"] = host_header

    for method in ("HEAD", "GET"):
        try:
            req = urllib.request.Request(
                url,
                method=method,
                headers=headers,
            )
            try:
                with urllib.request.urlopen(req, timeout=timeout) as resp:
                    code = getattr(resp, "status", None) or resp.getcode()
            except urllib.error.HTTPError as exc:
                # 401/403/404/405/5xx 仍然说明后端在线。
                code = exc.code
            note = f"HTTP {code} ({method})"
            if int(code) >= 400:
                note += "（业务状态码已忽略）"
            # 很多 API 不实现 HEAD；用 GET 复核，避免把 405/501 误判成异常。
            if method == "HEAD" and int(code) in (405, 501):
                continue
            return True, note
        except Exception as exc:
            last_err = str(exc)

    try:
        parsed = urllib.parse.urlparse(
            service_url if "://" in service_url else f"http://{service_url}"
        )
        host = parsed.hostname or "127.0.0.1"
        port = parsed.port or (443 if (parsed.scheme or "http") == "https" else 80)
        with socket.create_connection((host, int(port)), timeout=timeout):
            return True, f"TCP {host}:{port} 可达（HTTP 探测失败，按端口放行）"
    except Exception as exc:
        last_err = f"{last_err}; TCP: {exc}"
    return False, last_err or "未知错误"


def check_local_backend(
    service_url: str, timeout: int = 5, host_header: Optional[str] = None
) -> None:
    """配置前检查本地后端，避免隧道建好但业务 502。"""
    ok, detail = probe_local_backend(service_url, timeout=timeout, host_header=host_header)
    if ok:
        cprint(f"本地后端探活: {service_url} -> {detail}", "green")
        return
    raise CFError(f"本地后端不可达: {service_url}; 错误: {detail}")


def backend_status_code(detail: str) -> Optional[int]:
    match = re.search(r"\bHTTP\s+(\d{3})\b", detail)
    return int(match.group(1)) if match else None


def verify_https(hostname: str, timeout: int = 25) -> Tuple[bool, str]:
    """HTTPS 验收：公共 DNS + curl 响应头。"""
    dig = run(["dig", "+short", "@1.1.1.1", "CNAME", hostname], check=False)
    diga = run(["dig", "+short", "@1.1.1.1", hostname], check=False)
    curl = run(
        [
            "curl",
            "-sI",
            "--noproxy",
            "*",
            "--max-time",
            str(timeout),
            "--connect-timeout",
            "10",
            "-L",
            f"https://{hostname}/",
        ],
        check=False,
    )
    head = "\n".join((curl.stdout or "").splitlines()[:12])
    detail = (
        f"公共DNS CNAME:\n{(dig.stdout or '').strip() or '(空)'}\n"
        f"公共DNS 解析:\n{(diga.stdout or '').strip() or '(空)'}\n"
        f"HTTPS 响应头:\n{head or '(空)'}\n"
        f"curl_exit={curl.returncode}"
    )
    ok = False
    for line in (curl.stdout or "").splitlines():
        if line.upper().startswith("HTTP/"):
            parts = line.split()
            if len(parts) >= 2 and parts[1].isdigit():
                code = int(parts[1])
                if 200 <= code < 500:
                    ok = True
            break
    return ok, detail


def set_preferred_target(target: str, note: str = "") -> dict:
    global PREFERRED_TARGET
    target = normalize_cdn_target(target)
    rec = upsert_dns(
        AUX_ZONE_ID,
        'CNAME',
        PREFERRED_ENTRY,
        target,
        proxied=False,
        ttl=120,
        comment=note or f"preferred CDN switched at {datetime.now().isoformat(timespec='seconds')}",
    )
    confirmed = wait_dns_cname(AUX_ZONE_ID, PREFERRED_ENTRY, target, timeout=30)
    if confirmed != target:
        raise CFError(
            f"优选 CDN 切换未被 API 确认: {PREFERRED_ENTRY} -> {confirmed or '(空)'} "
            f"（期望 {target}）"
        )
    PREFERRED_TARGET = target
    cprint(f"已切换优选 CDN: {PREFERRED_ENTRY} -> {target} (关黄云)", 'green')
    return rec


def dig_ips(domain: str, limit: int = 8) -> List[str]:
    ips: List[str] = []
    seen = set()
    for rtype in ("A", "AAAA"):
        p = run(['dig', '+short', rtype, domain], check=False, timeout=15)
        for line in (p.stdout or '').splitlines():
            line = line.strip().rstrip('.')
            try:
                ipaddress.ip_address(line)
            except ValueError:
                continue
            if line not in seen:
                seen.add(line)
                ips.append(line)
    return ips[:limit]


def ping_ip(ip: str, count: int = 4) -> Tuple[List[float], Optional[int]]:
    if shutil.which('ping') is None:
        return [], None
    try:
        command = ['ping']
        if ':' in ip:
            command.append('-6')
        p = subprocess.run(
            command + ['-c', str(count), '-W', '1', ip],
            capture_output=True,
            text=True,
            timeout=12,
        )
        times = [float(x) for x in re.findall(r'time=([\d.]+)', p.stdout or '')]
        loss = None
        m = re.search(r'(\d+)% packet loss', p.stdout or '')
        if m:
            loss = int(m.group(1))
        return times, loss
    except Exception:
        return [], 100


def tcp_latency(ip: str, port: int = 443, tries: int = 4, timeout: float = 2.0) -> List[float]:
    vals: List[float] = []
    for _ in range(tries):
        t0 = time.perf_counter()
        try:
            # create_connection 自动选择 IPv4/IPv6，避免 AAAA 候选被误判为失败。
            with socket.create_connection((ip, port), timeout=timeout):
                pass
            vals.append((time.perf_counter() - t0) * 1000)
        except Exception:
            pass
    return vals


def https_latency(
    domain: str, ip: str, tries: int = 3, timeout: float = 6.0
) -> Tuple[List[float], List[float], List[int]]:
    """用真实 Host/SNI 访问指定 IP，返回 (TLS 完成时间, TTFB, HTTP 状态码)。"""
    tls_vals: List[float] = []
    ttfb_vals: List[float] = []
    statuses: List[int] = []
    resolve_ip = f"[{ip}]" if ":" in ip else ip
    for _ in range(tries):
        p = run(
            [
                "curl",
                "-sS",
                "-I",
                "--noproxy",
                "*",
                "-o",
                "/dev/null",
                "--connect-timeout",
                str(max(1, int(timeout))),
                "--max-time",
                str(max(2, int(timeout))),
                "--resolve",
                f"{domain}:443:{resolve_ip}",
                "-w",
                "%{http_code} %{time_appconnect} %{time_starttransfer}",
                f"https://{domain}/",
            ],
            check=False,
            timeout=max(10, int(timeout) + 5),
        )
        fields = (p.stdout or "").strip().split()
        if len(fields) < 3:
            continue
        try:
            status = int(fields[0])
            tls_ms = float(fields[1]) * 1000
            ttfb_ms = float(fields[2]) * 1000
        except ValueError:
            continue
        if status <= 0 or tls_ms <= 0:
            continue
        statuses.append(status)
        tls_vals.append(tls_ms)
        ttfb_vals.append(ttfb_ms)
    return tls_vals, ttfb_vals, statuses


def _benchmark_ip(domain: str, ip: str, ping_count: int, tcp_tries: int) -> dict:
    times, loss = ping_ip(ip, count=ping_count)
    tcp = tcp_latency(ip, tries=tcp_tries)
    tls, ttfb, statuses = https_latency(domain, ip, tries=max(2, min(3, tcp_tries)))
    return {
        'ip': ip,
        'ping_avg': statistics.mean(times) if times else None,
        'ping_min': min(times) if times else None,
        'ping_loss': loss,
        'tcp_avg': statistics.mean(tcp) if tcp else None,
        'tcp_min': min(tcp) if tcp else None,
        'tcp_median': statistics.median(tcp) if tcp else None,
        'tcp_ok': len(tcp),
        'tcp_tries': tcp_tries,
        'https_avg': statistics.mean(tls) if tls else None,
        'https_min': min(tls) if tls else None,
        'https_median': statistics.median(tls) if tls else None,
        'ttfb_avg': statistics.mean(ttfb) if ttfb else None,
        'https_ok': len(tls),
        'https_tries': max(2, min(3, tcp_tries)),
        'http_statuses': statuses,
    }


def benchmark_cdn(domain: str, ping_count: int = 4, tcp_tries: int = 4) -> dict:
    ips = dig_ips(domain)
    all_ping: List[float] = []
    all_tcp: List[float] = []
    all_https: List[float] = []
    all_ttfb: List[float] = []
    rows: List[dict] = []
    if ips:
        workers = min(8, len(ips))
        with ThreadPoolExecutor(max_workers=workers) as pool:
            futures = {
                pool.submit(_benchmark_ip, domain, ip, ping_count, tcp_tries): ip
                for ip in ips
            }
            by_ip: Dict[str, dict] = {}
            for future in as_completed(futures):
                ip = futures[future]
                try:
                    by_ip[ip] = future.result()
                except Exception as exc:
                    by_ip[ip] = {
                        'ip': ip,
                        'ping_avg': None,
                        'ping_min': None,
                        'ping_loss': 100,
                        'tcp_avg': None,
                        'tcp_min': None,
                        'tcp_median': None,
                        'tcp_ok': 0,
                        'tcp_tries': tcp_tries,
                        'https_avg': None,
                        'https_min': None,
                        'https_median': None,
                        'ttfb_avg': None,
                        'https_ok': 0,
                        'https_tries': max(2, min(3, tcp_tries)),
                        'http_statuses': [],
                        'error': str(exc),
                    }
            rows = [by_ip[ip] for ip in ips]
    for row in rows:
        # 只把成功样本纳入聚合统计，避免失败值扭曲平均数。
        if row.get('ping_avg') is not None:
            all_ping.append(row['ping_avg'])
        if row.get('tcp_avg') is not None:
            all_tcp.append(row['tcp_avg'])
        if row.get('https_avg') is not None:
            all_https.append(row['https_avg'])
        if row.get('ttfb_avg') is not None:
            all_ttfb.append(row['ttfb_avg'])
    https_ok = sum(int(r.get('https_ok') or 0) for r in rows)
    https_tries = sum(int(r.get('https_tries') or 0) for r in rows)
    tcp_ok = sum(int(r.get('tcp_ok') or 0) for r in rows)
    tcp_tries_total = sum(int(r.get('tcp_tries') or 0) for r in rows)
    https_samples = [
        r['https_median'] for r in rows if r.get('https_median') is not None
    ]
    tcp_samples = [
        r['tcp_median'] for r in rows if r.get('tcp_median') is not None
    ]
    return {
        'domain': domain,
        'ips': ips,
        'ip_count': len(ips),
        'rows': rows,
        'best_ping': min((r['ping_min'] for r in rows if r['ping_min'] is not None), default=None),
        'avg_ping': statistics.mean(all_ping) if all_ping else None,
        'best_tcp': min((r['tcp_min'] for r in rows if r['tcp_min'] is not None), default=None),
        'avg_tcp': statistics.mean(all_tcp) if all_tcp else None,
        'median_tcp': statistics.median(tcp_samples) if tcp_samples else None,
        'best_https': min((r['https_min'] for r in rows if r['https_min'] is not None), default=None),
        'avg_https': statistics.mean(all_https) if all_https else None,
        'median_https': statistics.median(https_samples) if https_samples else None,
        'avg_ttfb': statistics.mean(all_ttfb) if all_ttfb else None,
        'https_ok': https_ok,
        'https_tries': https_tries,
        'https_success_rate': (https_ok / https_tries) if https_tries else 0.0,
        'tcp_ok': tcp_ok,
        'tcp_tries': tcp_tries_total,
        'ping_samples': len(all_ping),
        'tcp_samples': len(all_tcp),
    }


def rank_cdn_results(results: List[dict]) -> List[dict]:
    return sorted(
        results,
        key=lambda x: (
            x.get('https_ok', 0) == 0,
            -(x.get('https_success_rate') or 0.0),
            x.get('median_https') if x.get('median_https') is not None else 1e9,
            x.get('avg_ttfb') if x.get('avg_ttfb') is not None else 1e9,
            x.get('median_tcp') if x.get('median_tcp') is not None else 1e9,
            x.get('best_ping') if x.get('best_ping') is not None else 1e9,
        ),
    )


def fmt_ms(v: Optional[float]) -> str:
    return '-' if v is None else f"{v:.2f}ms"


def print_cdn_benchmark(results: List[dict], current: Optional[str] = None) -> List[dict]:
    ranked = rank_cdn_results(results)
    cprint('\n====== 优选 CDN 测速结果（本机出口）======', 'bold')
    for i, r in enumerate(ranked, 1):
        mark = ''
        if current and r['domain'] == current:
            mark = '  [当前]'
        cprint(
            f"{i}. {r['domain']}{mark}\n"
            f"https={fmt_ms(r.get('median_https'))}  TTFB={fmt_ms(r.get('avg_ttfb'))}  "
            f"可用率={r.get('https_success_rate', 0.0) * 100:.0f}%\n"
            f"   tcp_best={fmt_ms(r['best_tcp'])}  tcp_median={fmt_ms(r.get('median_tcp'))}  "
            f"ping_best={fmt_ms(r['best_ping'])}  ips={r['ip_count']}",
            'green' if i == 1 else None,
        )
        for row in r['rows']:
            loss = '-' if row.get('ping_loss') is None else f"{row['ping_loss']}%"
            cprint(
                f"     - {row['ip']:39s} https={fmt_ms(row.get('https_median'))} "
                f"status={','.join(map(str, row.get('http_statuses') or [])) or '-'} "
                f"tcp_avg={fmt_ms(row['tcp_avg'])} ok={row['tcp_ok']}/{row['tcp_tries']} "
                f"ping_avg={fmt_ms(row['ping_avg'])} loss={loss}"
            )
    if ranked:
        cprint(f"\n本机测速最优: {ranked[0]['domain']}", 'green')
    return ranked


def cdn_latency_score(result: dict) -> Optional[float]:
    """用于比较的稳定延迟：优先 HTTPS 中位数，退化到 TCP 中位数。"""
    if result.get('median_https') is not None and result.get('https_ok', 0):
        return float(result['median_https'])
    if result.get('median_tcp') is not None and result.get('tcp_ok', 0):
        return float(result['median_tcp'])
    return None


def normalize_cdn_target(raw: str) -> str:
    target = (raw or '').strip().lower().rstrip('.')
    if not HOST_RE.match(target):
        raise CFError(f"优选 CDN 域名格式不正确: {raw}")
    return target


def ensure_candidate_list(extra: Optional[List[str]] = None) -> List[str]:
    items: List[str] = []
    for d in list(CDN_CANDIDATES) + list(extra or []):
        if not d:
            continue
        d = normalize_cdn_target(d)
        if d not in items:
            items.append(d)
    current = get_current_preferred_target(strict=True)
    if current:
        current = normalize_cdn_target(current)
        if current not in items:
            items.insert(0, current)
    return items


def test_and_maybe_switch_cdn(
    auto_apply_best: bool = False,
    candidates: Optional[List[str]] = None,
    interactive: bool = False,
    force: bool = False,
) -> Optional[str]:
    current = get_current_preferred_target(strict=True)
    domains = candidates or ensure_candidate_list()
    cprint(f"当前优选 CDN: {current}", 'cyan')
    cprint(f"候选: {', '.join(domains)}", 'cyan')
    results = []
    for d in domains:
        cprint(f"测速中: {d} ...", 'blue')
        results.append(benchmark_cdn(d))
    ranked = print_cdn_benchmark(results, current=current)
    if not ranked:
        raise CFError('没有可测速的候选 CDN')
    usable = [r for r in ranked if cdn_latency_score(r) is not None]
    if not usable:
        raise CFError('所有候选 CDN 均未通过 HTTPS/TCP 探测，保持当前配置不变')
    best = ranked[0]['domain']
    if auto_apply_best:
        if best == current:
            cprint('最优已是当前 CDN，无需切换。', 'green')
            return current
        best_result = next(r for r in ranked if r['domain'] == best)
        current_result = next((r for r in ranked if r['domain'] == current), None)
        best_score = cdn_latency_score(best_result)
        current_score = cdn_latency_score(current_result) if current_result else None
        if (
            not force
            and current_score is not None
            and best_score is not None
            and current_score > 0
        ):
            improvement = (current_score - best_score) / current_score * 100
            if improvement < CDN_SWITCH_MIN_IMPROVEMENT_PERCENT:
                cprint(
                    f'当前 CDN 仍足够稳定（预计仅改善 {improvement:.1f}% < '
                    f'{CDN_SWITCH_MIN_IMPROVEMENT_PERCENT:.1f}%），不切换。可用 --force 强制切换。',
                    'green',
                )
                return current
        set_preferred_target(best)
        return best

    if not interactive:
        cprint('仅测速，未修改 DNS。需要选择切换请使用交互菜单。', 'cyan')
        return current

    # 交互选择
    cprint('\n切换选项:', 'bold')
    cprint('  0) 不切换，仅查看结果')
    for i, r in enumerate(ranked, 1):
        tag = ' (当前最优)' if i == 1 else ''
        now = ' [当前使用]' if r['domain'] == current else ''
        cprint(f"  {i}) 切换到 {r['domain']}{tag}{now}")
    cprint(f"  c) 手动输入其它 CDN 域名")
    choice = input('请选择: ').strip().lower()
    if choice in ('', '0'):
        cprint('未切换。', 'yellow')
        return current
    if choice == 'c':
        custom = prompt('输入优选 CDN 域名').strip().lower().rstrip('.')
        set_preferred_target(custom)
        return custom
    if choice.isdigit() and 1 <= int(choice) <= len(ranked):
        target = ranked[int(choice) - 1]['domain']
        if target == current and not prompt_yes_no(f'{target} 已是当前值，仍要重写 DNS 吗？', False):
            return current
        set_preferred_target(target)
        return target
    raise CFError('无效选择')


def interactive_cdn_menu() -> None:
    current = get_current_preferred_target(strict=True)
    cprint(f"\n当前: {PREFERRED_ENTRY} -> {current}", 'cyan')
    cprint('  1) 测速全部候选并选择切换')
