def add_accelerated_service(
    hostname: str, service_url: str, external: bool = False
) -> None:
    cprint("\n====== 开始自动配置 ======", "bold")
    cprint(f"域名: {hostname}", "cyan")
    cprint(f"后端: {service_url}", "cyan")

    zone = resolve_zone(hostname)
    if zone is None:
        if not external:
            print_domains(show_dns=False)
            raise CFError(
                f"{hostname} 不属于本账号任何 Cloudflare zone；"
                "上面的清单是本账号里能自动配置的域名。"
                "如果一定要用这个域名（解析手动加），改用: "
                f"cf-tunnel-accel add {hostname} {service_url} --external"
            )
        zone_name, zone_id = "(外部域名)", None
        cprint("该域名不在本账号：按 --external 手动 DNS 模式继续。", "yellow")
    else:
        zone_name, zone_id = zone
        cprint(f"所属 zone: {zone_name}", "cyan")

    # 0) 本地后端探活，避免“隧道配置成功但访问 502”
    check_local_backend(service_url, host_header=hostname)

    # 1) 基础入口
    ensure_origin_dns()
    ensure_preferred_entry_dns()
    ensure_fallback_origin()
    current_cdn = get_current_preferred_target(strict=True)

    # 2) tunnel：配置变更才重启；校验/重启失败自动恢复调用前版本。
    config_before = CONFIG_PATH.read_text(encoding="utf-8")
    try:
        config_changed = upsert_tunnel_hostname(hostname, service_url)
        # 确保 origin 在 ingress 中，而不是只在注释或其它字段中出现。
        cfg_lines = CONFIG_PATH.read_text(encoding="utf-8").splitlines()
        if not _has_ingress_hostname(cfg_lines, FALLBACK_ORIGIN):
            config_changed = (
                upsert_tunnel_hostname(FALLBACK_ORIGIN, "http://127.0.0.1:8317")
                or config_changed
            )
        if config_changed:
            validate_and_restart_tunnel(rollback_text=config_before)
        else:
            active, state = _systemd_active()
            if not active:
                _validate_and_restart_once()
            else:
                cprint("Tunnel 配置未变更，跳过重启。", "cyan")
    except Exception:
        # 若配置阶段在校验前就中断，也不要留下半套 ingress。
        try:
            if CONFIG_PATH.read_text(encoding="utf-8") != config_before:
                atomic_write_text(CONFIG_PATH, config_before)
        except Exception:
            pass
        raise

    # 3) SaaS custom hostname
    cprint("创建/获取 SaaS 自定义主机名...", "blue")
    ch = create_or_get_custom_hostname(hostname)
    ch = refresh_custom_hostname(ch["id"])
    apply_saas_validation_records(hostname, ch, zone_id)

    # 4) 先指到 origin 做激活（必须关黄云，且 CNAME 到 SaaS 区主机名）
    if zone_id:
        cprint("临时解析到回退源以完成 SaaS 激活...", "blue")
        upsert_dns(
            zone_id,
            "CNAME",
            hostname,
            FALLBACK_ORIGIN,
            proxied=False,
            ttl=60,
            comment="temp for saas activation",
        )
        api_cname = wait_dns_cname(zone_id, hostname, FALLBACK_ORIGIN, timeout=60)
        cprint(f"API 确认激活 CNAME: {hostname} -> {api_cname}", "cyan")
    else:
        cprint("\n请在你的域名 DNS 处先添加（关黄云 / DNS only）:", "yellow")
        cprint(f"  CNAME {hostname} -> {FALLBACK_ORIGIN}", "yellow")
        if read_line("添加完成后按回车，脚本会等待 SaaS 激活...") is None:
            raise CFError("输入结束（EOF），已中止；DNS 未改动")

    # 5) 等待 active
    cprint("等待自定义主机名 Active / 证书签发...", "blue")
    ch = wait_custom_hostname_active(ch["id"], timeout=420, zone_id=zone_id, hostname=hostname)
    cprint(
        f"SaaS 状态: {ch.get('status')}, SSL: {(ch.get('ssl') or {}).get('status')}",
        "green",
    )

    # 6) 切到优选入口（关黄云），并强制 API 确认写成功
    if zone_id:
        cprint("切换到优选入口...", "blue")
        upsert_dns(
            zone_id,
            "CNAME",
            hostname,
            PREFERRED_ENTRY,
            proxied=False,
            ttl=120,
            comment="preferred CF entry via dual-domain saas",
        )
        api_cname = wait_dns_cname(zone_id, hostname, PREFERRED_ENTRY, timeout=90)
        if api_cname != PREFERRED_ENTRY.rstrip("."):
            raise CFError(
                f"切换优选入口失败: API CNAME={api_cname} 期望={PREFERRED_ENTRY}"
            )
        cprint(f"API 确认优选 CNAME: {hostname} -> {api_cname}", "green")
    else:
        cprint("接下来把 DNS 指向优选入口（手动）:", "yellow")
        cprint(f"  CNAME {hostname} -> {PREFERRED_ENTRY}（关黄云 / DNS only）", "yellow")
        cprint(f"然后执行: cf-tunnel-accel switch {hostname} 再次确认", "yellow")

    # 7) 验收（公共 DNS + HTTPS；不再只信本机 dig 缓存）
    cprint("验收中...", "blue")
    time.sleep(3)
    ok, detail = verify_https(hostname)
    cprint(detail)
    if not ok:
        cprint(
            "警告: HTTPS 验收未通过。可能是公共 DNS 尚未刷新，或当前优选 CDN 线路异常。"
            "可稍后重试，或执行: cf-tunnel-accel cdn best / cf-tunnel-accel switch "
            + hostname,
            "yellow",
        )
    else:
        cprint("HTTPS 验收通过", "green")

    cprint("\n====== 完成 ======", "bold")
    cprint(f"访问: https://{hostname}", "green")
    cprint(
        f"链路: {hostname} -> {PREFERRED_ENTRY} -> {current_cdn} -> SaaS -> "
        f"{FALLBACK_ORIGIN} -> tunnel -> {service_url}",
        "green",
    )


def remove_service(hostname: str) -> None:
    cprint(f"\n开始删除业务域名: {hostname}", "bold")
    if hostname in (FALLBACK_ORIGIN, PREFERRED_ENTRY):
        raise CFError("系统入口不允许删除")

    # tunnel
    config_before = CONFIG_PATH.read_text(encoding="utf-8") if CONFIG_PATH.exists() else None
    if remove_tunnel_hostname(hostname):
        cprint("已从隧道配置移除", "green")
        validate_and_restart_tunnel(rollback_text=config_before)
    else:
        cprint("隧道配置中未找到该主机名", "yellow")

    # saas
    if delete_custom_hostname(hostname):
        cprint("已删除 SaaS 自定义主机名", "green")
    else:
        cprint("SaaS 中未找到该主机名", "yellow")

    # dns（外部域名没有自动解析，跳过并提示）
    zone = resolve_zone(hostname)
    if zone is None:
        cprint(
            f"{hostname} 不在本账号 zone 下，跳过自动 DNS 清理；"
            "如有手动解析请自行删除。",
            "yellow",
        )
    else:
        zone_name, zone_id = zone
        n = 0
        n += delete_dns_name(zone_id, hostname)
        n += delete_dns_name(zone_id, f"_cf-custom-hostname.{hostname}")
        n += delete_dns_name(zone_id, f"_acme-challenge.{hostname}")
        # 再扫一遍 API，防止遗留同名不同 type
        leftover = list_dns(zone_id, hostname)
        leftover += list_dns(zone_id, f"_cf-custom-hostname.{hostname}")
        leftover += list_dns(zone_id, f"_acme-challenge.{hostname}")
        for r in leftover:
            api_ok(
                api("DELETE", f"/zones/{zone_id}/dns_records/{r['id']}"),
                f"补删残留 {r['type']} {r['name']}",
            )
            n += 1
        cprint(f"已清理 DNS 共 {n} 条 zone={zone_name}", "green")
    cprint("删除完成", "green")

