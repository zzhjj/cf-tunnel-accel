def install_cdn_schedule(interval_hours: int = 6) -> None:
    """安装可选的 systemd 定时优选任务。"""
    if not (1 <= interval_hours <= 168):
        raise CFError("定时优选间隔必须是 1 到 168 小时")
    script = str(Path(__file__).resolve())
    service_text = f"""[Unit]
Description=Probe and optimize Cloudflare Tunnel CDN entry
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=10min
ExecStart={script} cdn best
WorkingDirectory=/root
StandardOutput=journal
StandardError=journal
"""
    timer_text = f"""[Unit]
Description=Periodic Cloudflare Tunnel CDN optimization

[Timer]
OnBootSec=5min
OnUnitActiveSec={interval_hours}h
RandomizedDelaySec=5min
Persistent=true
Unit=cf-tunnel-accel-cdn.service

[Install]
WantedBy=timers.target
"""
    for path, content in (
        (AUTO_CDN_SERVICE_UNIT, service_text),
        (AUTO_CDN_TIMER_UNIT, timer_text),
    ):
        if path.exists():
            ts = datetime.now().strftime("%Y%m%d-%H%M%S-%f")
            shutil.copy2(path, path.with_suffix(path.suffix + f".bak.{ts}"))
        atomic_write_text(path, content)
        os.chmod(path, 0o644)
    run(["systemctl", "daemon-reload"])
    run(["systemctl", "enable", "--now", AUTO_CDN_TIMER_UNIT.name])
    cprint(
        f"已安装 CDN 自动优选：每 {interval_hours} 小时执行一次（防抖阈值 "
        f"{CDN_SWITCH_MIN_IMPROVEMENT_PERCENT:.0f}%）。",
        "green",
    )


def remove_cdn_schedule() -> None:
    run(
        ["systemctl", "disable", "--now", AUTO_CDN_TIMER_UNIT.name],
        check=False,
    )
    for path in (AUTO_CDN_TIMER_UNIT, AUTO_CDN_SERVICE_UNIT):
        try:
            path.unlink()
        except FileNotFoundError:
            pass
    run(["systemctl", "daemon-reload"])
    cprint("已移除 CDN 自动优选定时任务。", "green")


