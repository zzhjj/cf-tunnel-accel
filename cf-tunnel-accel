        cprint(
            f"  [{r['name']}] {len(r['hostnames'])} 个:"
            f" {_shorten(r['hostnames'])}"
        )
    if unused_rows:
        detail = [
            r["name"]
            + (f"（已有 {len(r['addressed'])} 条 A/AAAA）" if r["addressed"] else "")
            for r in unused_rows
        ]
        cprint(f"  尚未加速（可直接拿来新增）: {', '.join(detail)}", "cyan")

    if not offline:
        try:
            quota = saas_quota()
        except Exception:
            quota = None
        if quota:
            flag = "，已超额" if quota.get("exceeded") else ""
            cprint(
                f"\nSaaS 自定义主机名配额: {quota.get('used')} / {quota.get('allocated')}"
                f"（hard cap {quota.get('hard_cap')}{flag}）",
                "yellow" if quota.get("exceeded") else "cyan",
            )
        for r in rows:
            if r["id"] == AUX_ZONE_ID or not r["fallback_origin"]:
                continue
            cprint(
                f"\n注意: {r['name']} 也配了 SaaS fallback origin = {r['fallback_origin']}",
                "yellow",
            )
            resp = api("GET", f"/zones/{r['id']}/custom_hostnames?per_page=100")
            for item in resp.get("result") or []:
                cprint(
                    f"  - 非本脚本管理: {item.get('hostname')} status={item.get('status')}"
                    f" ssl={(item.get('ssl') or {}).get('status')}",
                    "yellow",
                )

    cprint(
        f"\n当前优选入口: {PREFERRED_ENTRY} -> {get_current_preferred_target()}",
        "cyan",
    )
    example = next((r["name"] for r in rows if r["usable"]), AUX_ZONE_NAME)
    cprint("\n====== 下一步 ======", "bold")
    cprint("  交互新增（从上表里挑）: cf-tunnel-accel add", "cyan")
    cprint(f"  只给 zone 再挑子域名:  cf-tunnel-accel add {example}", "cyan")
    cprint(
        f"  完整写法:              cf-tunnel-accel add app.{example} 127.0.0.1:8080",
        "cyan",
    )
    cprint(
        "  域名不在本账号:        cf-tunnel-accel add x.example.com 127.0.0.1:8080 --external",
        "cyan",
    )
    return 0


