def ensure_fallback_origin() -> None:
    resp = api("GET", f"/zones/{AUX_ZONE_ID}/custom_hostnames/fallback_origin")
    cur = (resp.get("result") or {}).get("origin")
    status = (resp.get("result") or {}).get("status")
    if cur == FALLBACK_ORIGIN and status == "active":
        cprint(f"回退源已就绪: {FALLBACK_ORIGIN}", "green")
        return
    api_ok(
        api(
            "PUT",
            f"/zones/{AUX_ZONE_ID}/custom_hostnames/fallback_origin",
            {"origin": FALLBACK_ORIGIN},
        ),
        "设置回退源",
    )
    cprint(f"已设置回退源: {FALLBACK_ORIGIN}", "green")


def ensure_preferred_entry_dns() -> None:
    # origin 由 tunnel 管理，这里确保 cdn 优选入口存在；保留已切换过的目标
    # 读取失败时宁可停止，不能把现有的优选目标静默改回默认值。
    current = get_current_preferred_target(strict=True)
    target = current or PREFERRED_TARGET
    upsert_dns(
        AUX_ZONE_ID,
        "CNAME",
        PREFERRED_ENTRY,
        target,
        proxied=False,
        ttl=120,
        comment="preferred CF entry",
    )
    cprint(f"优选入口已就绪: {PREFERRED_ENTRY} -> {target} (关黄云)", "green")



def list_custom_hostnames() -> List[dict]:
    items: List[dict] = []
    page = 1
    while True:
        resp = api_ok(
            api("GET", f"/zones/{AUX_ZONE_ID}/custom_hostnames?per_page=50&page={page}"),
            "列出自定义主机名",
        )
        batch = resp.get("result") or []
        items.extend(batch)
        info = resp.get("result_info") or {}
        total_pages = int(info.get("total_pages") or 1)
        if page >= total_pages or not batch:
            break
        page += 1
    return items

