def _systemd_active() -> Tuple[bool, str]:
    try:
        p = run(["systemctl", "is-active", SERVICE_NAME], check=False, timeout=10)
        state = (p.stdout or "").strip() or (p.stderr or "").strip()
        return state == "active", state or "unknown"
    except CFError as exc:
        return False, str(exc)


