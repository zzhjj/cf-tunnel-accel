def _main_locked(argv: List[str]) -> int:
    first_cmd = argv[1].lower() if len(argv) >= 2 else ""
    offline_env = first_cmd in ("env", "config", "show-config")
    offline_ok = offline_env or first_cmd in (
        "domains",
        "zones",
        "list-domains",
    )
    try:
        check_token()
    except Exception as exc:
        if offline_env:
            cprint(f"Token 检查失败（仍显示本机配置）: {exc}", "yellow")
            return print_env()
        if offline_ok:
            # 没有 Token 也要能看“账号里有哪些域名”，退回本机缓存清单
            cprint(f"Token 检查失败（改用本机缓存清单）: {exc}", "yellow")
            return 0 if print_domains(offline=True) == 0 else 1
        cprint(f"Token 检查失败: {exc}", "red")
        return 1

    if len(argv) >= 2:
        cmd = argv[1].lower()
        try:
            if cmd in ("domains", "zones", "list-domains"):
                return print_domains(show_dns="--no-dns" not in argv[2:])
            if cmd in ("env", "config", "show-config"):
                return print_env()
            if cmd == "add":
                add_args = [a for a in argv[2:]]
                external = "--external" in add_args
                add_args = [a for a in add_args if a != "--external"]
                if len(add_args) > 2:
                    raise CFError("add 用法: add [域名或zone] [ip:port] [--external]")
                if not add_args:
                    hostname = choose_hostname_interactive()
                    if not hostname:
                        cprint("已取消", "yellow")
                        return 0
                elif SERVICE_RE.match(add_args[0]):
                    raise CFError("add 用法: add [域名或zone] [ip:port] [--external]")
                elif len(add_args) == 1:
                    raw = add_args[0]
                    bare = raw.strip().lower().rstrip(".")
                    try:
                        ensure_zone_cache()
                    except Exception:
                        pass
                    if bare in _zone_cache:
                        picked = _pick_subdomain(bare)
                        if not picked:
                            cprint("已取消", "yellow")
                            return 0
                        hostname = picked
                    elif HOST_RE.match(bare):
                        hostname = normalize_hostname(raw)
                        if resolve_zone(hostname) is None and not external:
                            cprint(
                                f"{hostname} 不在本账号 zone 列表里；自动写 DNS 需要本账号权限。",
                                "yellow",
                            )
                            if not prompt_yes_no("按手动 DNS 模式继续？", False):
                                print_domains(show_dns=False)
                                return 1
                            external = True
                    else:
                        picked = choose_hostname_interactive(raw)
                        if not picked:
                            cprint("已取消", "yellow")
                            return 0
                        hostname = picked
                else:
                    hostname = normalize_hostname(add_args[0])
                if len(add_args) == 2:
                    service = normalize_service(add_args[1])
                else:
                    cprint(
                        "输入本地服务，例如: 127.0.0.1:8080 或 192.168.8.1:80 或 8080",
                        "cyan",
                    )
                    service = normalize_service(prompt("本地服务 ip:port", "127.0.0.1:8080"))
                add_accelerated_service(hostname, service, external=external)
                return 0
            if cmd == "list":
                list_all()
                return 0
            if cmd in ("status", "show"):
                show_status()
                return 0
            if cmd in ("health", "check", "doctor"):
                health_args = [arg for arg in argv[2:] if arg not in ("--https", "-H")]
                if len(health_args) > 1:
                    raise CFError("health 最多接受一个域名")
                health_host = health_args[0].lower().rstrip(".") if health_args else None
                if health_host:
                    # 健康检查也允许检查系统回退源，因此不使用业务域名保留字限制。
                    if not HOST_RE.match(health_host):
                        raise CFError(f"域名格式不正确: {health_host}")
                return 0 if health_check(health_host, "--https" in argv or "-H" in argv) else 1
            if cmd in ("del", "delete", "rm") and len(argv) >= 3:
                remove_service(normalize_hostname(argv[2]))
                return 0
            if cmd == "switch" and len(argv) >= 3:
                switch_to_preferred(normalize_hostname(argv[2]))
                return 0
            if cmd == "cdn":
                sub = (argv[2].lower() if len(argv) >= 3 else "menu")
                if sub in ("show", "status", "current"):
                    cur = get_current_preferred_target(strict=True)
                    cprint(f"{PREFERRED_ENTRY} -> {cur}", "green")
                    return 0
                if sub in ("test", "bench", "ping"):
                    extras = argv[3:] if len(argv) > 3 else None
                    if extras and any(x.startswith("-") for x in extras):
                        raise CFError("cdn test 只接受 CDN 域名参数")
                    test_and_maybe_switch_cdn(
                        auto_apply_best=False,
                        candidates=ensure_candidate_list(extras) if extras else None,
                        interactive=False,
                    )
                    return 0
                if sub in ("best", "auto", "optimize"):
                    raw_args = argv[3:] if len(argv) > 3 else []
                    force = "--force" in raw_args
                    extras = [x for x in raw_args if x != "--force"]
                    if any(x.startswith("-") for x in extras):
                        raise CFError("未知参数；可用: cdn best [额外cdn...] [--force]")
                    test_and_maybe_switch_cdn(
                        auto_apply_best=True,
                        candidates=ensure_candidate_list(extras) if extras else None,
                        force=force,
                    )
                    return 0
                if sub in ("set", "use", "switch") and len(argv) >= 4:
                    set_preferred_target(argv[3])
                    return 0
                if sub == "menu":
                    interactive_cdn_menu()
                    return 0
                raise CFError("cdn 子命令: show | test [更多域名...] | best [--force] | set <cdn域名>")
            if cmd in ("schedule", "timer", "auto"):
                sub = argv[2].lower() if len(argv) >= 3 else "status"
                if sub in ("install", "enable", "on"):
                    try:
                        hours = int(argv[3]) if len(argv) >= 4 else 6
                    except ValueError:
                        raise CFError("定时任务间隔必须是整数小时") from None
                    install_cdn_schedule(hours)
                    return 0
                if sub in ("remove", "disable", "off", "uninstall"):
                    remove_cdn_schedule()
                    return 0
                if sub in ("status", "show"):
                    show_cdn_schedule()
                    return 0
                raise CFError("schedule 子命令: install [小时] | status | remove")
            cprint("参数不正确，进入交互菜单。可用 --help 查看。", "yellow")
        except Exception as exc:
            cprint(f"错误: {exc}", "red")
            return 1

    menu()
    return 0


def command_requires_lock(argv: List[str]) -> bool:
    """只让会改共享资源的命令持有写锁。"""
    if len(argv) < 2:
        return True  # 交互菜单可能执行任意写操作
    cmd = argv[1].lower()
    if cmd in (
        "list",
        "domains",
        "zones",
        "list-domains",
        "env",
        "config",
        "show-config",
        "status",
        "show",
        "health",
        "check",
        "doctor",
    ):
        return False
    if cmd == "cdn":
        sub = argv[2].lower() if len(argv) >= 3 else "menu"
        return sub not in ("show", "status", "current", "test", "bench", "ping")
    if cmd in ("schedule", "timer", "auto"):
        sub = argv[2].lower() if len(argv) >= 3 else "status"
        return sub not in ("status", "show")
    return True


def main(argv: List[str]) -> int:
    # 帮助/版本不应触发 API 请求、systemd 锁或网络依赖。
    if len(argv) >= 2 and argv[1].lower() in ("-h", "--help", "help"):
        print_help()
        return 0
    if len(argv) >= 2 and argv[1].lower() in ("-v", "--version", "version"):
        print(f"cf-tunnel-accel {SCRIPT_VERSION}")
        return 0
    try:
        if command_requires_lock(argv):
            with exclusive_lock():
                return _main_locked(argv)
        # 只读诊断/测速不修改共享状态，不阻塞正在进行的诊断或人工查看。
        return _main_locked(argv)
    except KeyboardInterrupt:
        cprint("\n已中断", "yellow")
        return 130
    except Exception as exc:
        cprint(f"错误: {exc}", "red")
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
