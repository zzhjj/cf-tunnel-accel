def atomic_write_text(path: Path, text: str) -> None:
    """以临时文件 + fsync + replace 写入，避免进程中断留下半份 YAML。"""
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        mode = path.stat().st_mode & 0o777
    except OSError:
        mode = 0o600
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}.{time.time_ns()}")
    try:
        with tmp.open("w", encoding="utf-8", newline="\n") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass


def backup_config() -> Path:
    ts = datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    bak = CONFIG_PATH.with_suffix(CONFIG_PATH.suffix + f".bak.{ts}")
    shutil.copy2(CONFIG_PATH, bak)
    return bak


def parse_ingress_hostnames(text: str) -> List[Tuple[str, str]]:
    """返回 [(hostname, service), ...]，不含 catch-all。"""
    lines = text.splitlines()
    items: List[Tuple[str, str]] = []
    i = 0
    while i < len(lines):
        m = re.match(r"^  - hostname:\s*(\S+)(?:\s+#.*)?\s*$", lines[i])
        if m:
            host = m.group(1)
            service = ""
            # YAML 属性允许夹杂空行/注释，查到下一个同级 ingress 项为止。
            j = i + 1
            while j < len(lines):
                candidate = lines[j]
                if re.match(r"^  - (?:hostname|service):", candidate):
                    break
                m2 = re.match(r"^    service:\s*(\S+)(?:\s+#.*)?\s*$", candidate)
                if m2:
                    service = m2.group(1)
                    break
                j += 1
            items.append((host, service))
        i += 1
    return items


def _has_ingress_hostname(lines: List[str], hostname: str) -> bool:
    pattern = re.compile(rf"^  - hostname:\s*{re.escape(hostname)}\s*(?:#.*)?$")
    return any(pattern.match(line) for line in lines)


def _ensure_fallback_ingress(lines: List[str]) -> bool:
    """确保 fallback ingress 存在，返回是否改动了 lines。"""
    if _has_ingress_hostname(lines, FALLBACK_ORIGIN):
        return False
    block = [
        f"  - hostname: {FALLBACK_ORIGIN}",
        "    service: http://127.0.0.1:8317",
        "",
    ]
    # 优先放到第一个 hostname 块之后，避免改变 catch-all 的最后规则。
    for idx, line in enumerate(lines):
        if line.startswith("  - hostname:"):
            j = idx + 1
            while j < len(lines) and (
                lines[j].startswith("    ") or not lines[j].strip()
            ):
                j += 1
            lines[j:j] = block
            return True
    # 没有 hostname 时放到 catch-all 之前。
    for idx, line in enumerate(lines):
        if re.match(r"^  - service:\s*", line):
            lines[idx:idx] = block
            return True
    lines.extend(block)
    return True


def upsert_tunnel_hostname(hostname: str, service_url: str) -> bool:
    """新增/更新 ingress；返回是否真的修改了配置。"""
    if not CONFIG_PATH.exists():
        raise CFError(f"找不到隧道配置: {CONFIG_PATH}")

    text = CONFIG_PATH.read_text(encoding="utf-8")
    if "ingress:" not in text:
        raise CFError("config 中找不到 ingress 段")

    host_line = f"  - hostname: {hostname}"
    service_line = f"    service: {service_url}"

    lines = text.splitlines()
    changed = False
    host_existed = False
    # 已存在则更新 service
    for idx, line in enumerate(lines):
        if re.match(rf"^  - hostname:\s*{re.escape(hostname)}\s*(?:#.*)?$", line):
            host_existed = True
            service_idx = None
            j = idx + 1
            while j < len(lines):
                if re.match(r"^  - (?:hostname|service):", lines[j]):
                    break
                if re.match(r"^    service:\s*", lines[j]):
                    service_idx = j
                    break
                j += 1
            if service_idx is not None:
                if lines[service_idx] != service_line:
                    lines[service_idx] = service_line
                    changed = True
            else:
                lines.insert(idx + 1, service_line)
                changed = True
            break
    else:
        # 新插入：放在 catch-all 前。
        insert_at = None
        for idx, line in enumerate(lines):
            if re.match(r"^  - service:\s*", line) and "hostname:" not in line:
                insert_at = idx
                break
        if insert_at is None:
            lines.extend([host_line, service_line])
        else:
            lines[insert_at:insert_at] = [host_line, service_line, ""]
        changed = True

    if _ensure_fallback_ingress(lines):
        changed = True
        cprint(f"已自动补回退源: {FALLBACK_ORIGIN}", "yellow")

    if not changed:
        cprint(f"隧道主机名已存在且无需更新: {hostname} -> {service_url}", "green")
        return False
    backup_config()
    atomic_write_text(CONFIG_PATH, "\n".join(lines) + "\n")
    action = "更新" if host_existed else "新增"
    cprint(f"已{action}隧道主机名: {hostname} -> {service_url}", "green")
    return True


def remove_tunnel_hostname(hostname: str) -> bool:
    if hostname in (FALLBACK_ORIGIN,):
        raise CFError("不能删除回退源主机名")
    if not CONFIG_PATH.exists():
        return False
    lines = CONFIG_PATH.read_text(encoding="utf-8").splitlines()
    out: List[str] = []
    i = 0
    removed = False
    while i < len(lines):
        if re.match(rf"^  - hostname:\s*{re.escape(hostname)}\s*(?:#.*)?$", lines[i]):
            removed = True
            i += 1
            # 跳过该 host 的缩进属性
            while i < len(lines) and (lines[i].startswith("    ") or lines[i].strip() == ""):
                # 只跳过紧随其后的属性；空行吃掉一个
                if lines[i].strip() == "":
                    i += 1
                    break
                i += 1
            continue
        out.append(lines[i])
        i += 1
    if removed:
        backup_config()
        atomic_write_text(CONFIG_PATH, "\n".join(out) + "\n")
    return removed


def _wait_service_active(timeout: int = 15) -> None:
    deadline = time.time() + timeout
    last = ""
    while time.time() < deadline:
        p = run(["systemctl", "is-active", SERVICE_NAME], check=False, timeout=10)
        last = (p.stdout or "").strip()
        if last == "active":
            return
        time.sleep(1)
    raise CFError(f"隧道服务未 active: {last or '(无状态)'}")


def _validate_and_restart_once() -> None:
    cprint("校验隧道配置...", "blue")
    run([CLOUDFLARED_BIN, "--config", str(CONFIG_PATH), "tunnel", "ingress", "validate"])
    cprint("重启隧道服务...", "blue")
    run(["systemctl", "restart", SERVICE_NAME])
    _wait_service_active()
    cprint(f"隧道服务已运行: {SERVICE_NAME}", "green")


def validate_and_restart_tunnel(rollback_text: Optional[str] = None) -> None:
    """校验并重启；新配置失败时自动恢复调用前的配置。"""
    try:
        _validate_and_restart_once()
    except Exception as exc:
        if rollback_text is None:
            raise
        cprint(f"新 Tunnel 配置未能生效，准备自动回滚: {exc}", "yellow")
        try:
            atomic_write_text(CONFIG_PATH, rollback_text)
            _validate_and_restart_once()
        except Exception as rollback_exc:
            raise CFError(
                f"新配置失败: {exc}; 自动回滚也失败: {rollback_exc}；"
                f"请检查 {CONFIG_PATH}"
            ) from None
        raise CFError(f"新配置未能生效，已自动回滚: {exc}") from None


