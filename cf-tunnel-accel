def normalize_hostname(raw: str) -> str:
    host = raw.strip().lower()
    host = re.sub(r"^https?://", "", host)
    host = host.split("/")[0].split(":")[0].strip(".")
    if not HOST_RE.match(host):
        raise CFError(f"域名格式不正确: {raw}")
    if host in (FALLBACK_ORIGIN, PREFERRED_ENTRY, AUX_ZONE_NAME):
        raise CFError("该主机名是系统保留入口，不能作为业务域名")
    return host


def normalize_service(raw: str) -> str:
    s = raw.strip()
    # 允许用户输入 8080 / :8080 / 127.0.0.1:8080 / http://ip:port
    if re.fullmatch(r":?\d{1,5}", s):
        s = f"127.0.0.1:{s.lstrip(':')}"
    m = SERVICE_RE.match(s)
    if not m:
        raise CFError(
            "本地服务格式不正确。示例: 127.0.0.1:8080 / localhost:3000 / 192.168.8.1:80"
        )
    port = int(m.group("port"))
    if not (1 <= port <= 65535):
        raise CFError(f"端口不合法: {port}")
    scheme = m.group("scheme") or "http://"
    host = m.group("host")
    if host == "localhost":
        host = "127.0.0.1"
    return f"{scheme}{host}:{port}"


