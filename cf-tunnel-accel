def list_zones() -> List[dict]:
    items: List[dict] = []
    page = 1
    while True:
        resp = api_ok(api("GET", f"/zones?per_page=50&page={page}"), "列出 zones")
        batch = resp.get("result") or []
        items.extend(batch)
        info = resp.get("result_info") or {}
        total_pages = int(info.get("total_pages") or 1)
        if page >= total_pages or not batch:
            break
        page += 1
    return items


def load_zone_cache_file() -> None:
    """读取本机 zone 清单（不联网）：Token 失效或离线时也能看到账号里有哪些域名。"""
    global _zone_cache_updated_at
    try:
        data = json.loads(ZONE_CACHE_PATH.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return
    if not isinstance(data, dict):
        return
    zones = data.get("zones") or []
    if isinstance(zones, dict):  # 兼容 {name: id} 形态
        zones = [{"name": k, "id": v} for k, v in zones.items()]
    for item in zones:
        if not isinstance(item, dict):
            continue
        name = str(item.get("name") or "").strip().lower()
        zid = str(item.get("id") or "").strip()
        if not name or not zid:
            continue
        _zone_cache[name] = zid
        meta = {k: v for k, v in item.items() if k != "name"}
        meta["name"] = name
        meta["cached"] = True
        _zone_info[name] = meta
        _zone_cache_from_disk.add(name)
    try:
        _zone_cache_updated_at = float(data.get("updated_at") or 0.0)
    except (TypeError, ValueError):
        _zone_cache_updated_at = 0.0


def save_zone_cache_file() -> None:
    if not _zone_info:
        return
    payload = {
        "version": _ZONE_CACHE_FILE_VERSION,
        "updated_at": _zone_cache_updated_at or time.time(),
        "aux_zone": AUX_ZONE_NAME,
        "zones": [
            {k: v for k, v in sorted(meta.items()) if k != "cached"}
            for _, meta in sorted(_zone_info.items())
        ],
    }
    try:
        atomic_write_text(
            ZONE_CACHE_PATH, json.dumps(payload, ensure_ascii=False, indent=2) + "\n"
        )
        os.chmod(ZONE_CACHE_PATH, 0o600)
    except Exception as exc:  # 缓存写失败不能影响主流程
        cprint(f"警告: zone 清单缓存写入失败: {exc}", "yellow")


def zone_cache_age() -> Optional[float]:
    if not _zone_cache_updated_at:
        return None
    return max(0.0, time.time() - _zone_cache_updated_at)


def zone_cache_age_text() -> str:
    age = zone_cache_age()
    if age is None:
        return "未知"
    if age < 90:
        return f"{age:.0f} 秒前"
    if age < 5400:
        return f"{age / 60:.0f} 分钟前"
    return f"{age / 3600:.1f} 小时前"


def refresh_zone_cache() -> None:
    """从 API 重建账号 zone 清单，并写入本机缓存。"""
    global _zone_cache_updated_at
    live: set = set()
    for z in list_zones():
        name = str(z.get("name") or "").strip().lower()
        zid = str(z.get("id") or "").strip()
        if not name or not zid:
            continue
        live.add(name)
        _zone_cache[name] = zid
        plan = z.get("plan") or {}
        _zone_info[name] = {
            "name": name,
            "id": zid,
            "status": z.get("status") or "unknown",
            "type": z.get("type") or "unknown",
            "paused": bool(z.get("paused")),
            "plan": plan.get("name") or plan.get("legacy_id") or "unknown",
            "account": (z.get("account") or {}).get("name") or "",
            "cached": False,
        }
    # 账号里已经删掉的域名别留在缓存里误导选择
    for stale in sorted(_zone_cache_from_disk - live):
        _zone_cache.pop(stale, None)
        _zone_info.pop(stale, None)
    _zone_cache_from_disk.clear()
    _zone_cache_updated_at = time.time()
    save_zone_cache_file()


def ensure_zone_cache(max_age: Optional[int] = None) -> None:
    """清单过期就刷新一次；刷新失败时继续用本机缓存。"""
    limit = ZONE_CACHE_TTL if max_age is None else max_age
    age = zone_cache_age()
    if age is not None and limit >= 0 and age <= limit:
        return
    try:
        refresh_zone_cache()
    except Exception as exc:
        if not _zone_cache:
            raise
        cprint(f"警告: zone 清单刷新失败，改用本机缓存（{exc}）", "yellow")


def zone_of_host(hostname: str) -> Optional[str]:
    """纯本地判断 hostname 属于哪个已缓存 zone（不发请求）。"""
    labels = str(hostname).lower().strip(".").split(".")
    for i in range(len(labels) - 1):
        candidate = ".".join(labels[i:])
        if candidate in _zone_cache:
            return candidate
    return None


def resolve_zone(hostname: str) -> Optional[Tuple[str, str]]:
    """返回 hostname 所属 zone（找不到返回 None，不抛异常）。"""
    host = str(hostname).lower().strip(".")
    hit = zone_of_host(host)
    if hit:
        return hit, _zone_cache[hit]
    try:
        refresh_zone_cache()
    except Exception:
        return None
    hit = zone_of_host(host)
    if hit:
        return hit, _zone_cache[hit]
    # 逐级查询，覆盖刚添加、清单还没刷到的情况
    labels = host.split(".")
    for i in range(len(labels) - 1):
        candidate = ".".join(labels[i:])
        resp = api("GET", f"/zones?name={urllib.parse.quote(candidate)}")
        if resp.get("success") and resp.get("result"):
            z = resp["result"][0]
            name = str(z.get("name") or candidate).strip().lower()
            _zone_cache[name] = z["id"]
            plan = z.get("plan") or {}
            _zone_info[name] = {
                "name": name,
                "id": z["id"],
                "status": z.get("status") or "unknown",
                "type": z.get("type") or "unknown",
                "paused": bool(z.get("paused")),
                "plan": plan.get("name") or plan.get("legacy_id") or "unknown",
                "account": "",
                "cached": False,
            }
            return name, z["id"]
    return None


def parent_zone_for_host(hostname: str) -> Tuple[str, str]:
    found = resolve_zone(hostname)
    if found is None:
        raise CFError(f"找不到域名 {hostname} 所属 Cloudflare zone，请确认已接入本账号。")
    return found


