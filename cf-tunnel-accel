            elif choice == "9":
                print_domains()
            elif choice == "0":
                cprint("再见。", "cyan")
                return
            else:
                cprint("无效选项", "yellow")
        except CFError as e:
            cprint(f"错误: {e}", "red")
        except KeyboardInterrupt:
            cprint("\n已中断", "yellow")
        except Exception as e:
            cprint(f"未预期错误: {e}", "red")
        print()


