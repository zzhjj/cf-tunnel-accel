def check_auxiliary_chain() -> int:
    """检查双域名方案的两个辅助入口及 SaaS fallback 配置。"""
    failures = 0
    cprint("辅助链路:", "cyan")
    expected_origin = f"{TUNNEL_ID}.cfargotunnel.com"
    try:
        origin = get_dns_record(AUX_ZONE_ID, FALLBACK_ORIGIN, "CNAME")
        origin_content = str((origin or {}).get("content") or "").rstrip(".")
        origin_ok = (
            origin is not None
            and origin_content == expected_origin.rstrip(".")
            and bool(origin.get("proxied"))
        )
        cprint(
            f"  {'PASS' if origin_ok else 'FAIL'} {FALLBACK_ORIGIN} -> "
            f"{origin_content or '(空)'} proxied={bool((origin or {}).get('proxied'))}",
            "green" if origin_ok else "red",
        )
        if not origin_ok:
            failures += 1
    except Exception as exc:
        cprint(f"  FAIL 回退源 DNS 检查: {exc}", "red")
        failures += 1

    try:
        entry = get_dns_record(AUX_ZONE_ID, PREFERRED_ENTRY, "CNAME")
        target = str((entry or {}).get("content") or "").rstrip(".")
        entry_ok = entry is not None and bool(target) and not bool(entry.get("proxied"))
        cprint(
            f"  {'PASS' if entry_ok else 'FAIL'} {PREFERRED_ENTRY} -> "
            f"{target or '(空)'} proxied={bool((entry or {}).get('proxied'))}",
            "green" if entry_ok else "red",
        )
        if not entry_ok:
            failures += 1
    except Exception as exc:
        cprint(f"  FAIL 优选入口 DNS 检查: {exc}", "red")
        failures += 1

    try:
        fallback = api_ok(
            api("GET", f"/zones/{AUX_ZONE_ID}/custom_hostnames/fallback_origin"),
            "读取 SaaS fallback origin",
        ).get("result") or {}
        fallback_ok = (
            fallback.get("origin") == FALLBACK_ORIGIN
            and fallback.get("status") == "active"
        )
        cprint(
            f"  {'PASS' if fallback_ok else 'FAIL'} SaaS fallback origin: "
            f"{fallback.get('origin') or '(空)'} / {fallback.get('status') or '-'}",
            "green" if fallback_ok else "red",
        )
        if not fallback_ok:
            failures += 1
    except Exception as exc:
        cprint(f"  FAIL SaaS fallback 检查: {exc}", "red")
        failures += 1
    return failures


def health_check(hostname: Optional[str] = None, include_https: bool = False) -> bool:
    """检查 Tunnel 服务、配置、每条本地后端及 SaaS/DNS 链路。"""
    cprint("\n====== Tunnel 全链路健康检查 ======", "bold")
    failures = 0
    if not CONFIG_PATH.exists():
        cprint(f"FAIL config 不存在: {CONFIG_PATH}", "red")
        return False

    text = CONFIG_PATH.read_text(encoding="utf-8")
    routes = parse_ingress_hostnames(text)
    if hostname:
        routes = [(h, s) for h, s in routes if h == hostname]
        if not routes:
            cprint(f"FAIL 配置中找不到 hostname: {hostname}", "red")
            return False

    active, state = _systemd_active()
    cprint(
        f"{'PASS' if active else 'FAIL'} systemd {SERVICE_NAME}: {state}",
        "green" if active else "red",
    )
    if not active:
        failures += 1

    validation = run(
        [CLOUDFLARED_BIN, "--config", str(CONFIG_PATH), "tunnel", "ingress", "validate"],
        check=False,
        timeout=30,
    )
    valid = validation.returncode == 0
    cprint(
        f"{'PASS' if valid else 'FAIL'} cloudflared ingress validate",
        "green" if valid else "red",
    )
    if not valid:
        failures += 1

    # 只有全量检查时才校验公共辅助链路；单域名检查保持快速。
    if hostname is None:
        failures += check_auxiliary_chain()

    custom_by_host: Dict[str, dict] = {}
    custom_error = ""
    try:
        custom_by_host = {
            str(item.get("hostname")): item for item in list_custom_hostnames()
        }
    except Exception as exc:
        custom_error = str(exc)
        cprint(f"WARN SaaS 状态读取失败: {exc}", "yellow")
        # 无法读取 SaaS 状态时不能把整条链路误报为健康。
        failures += 1

    for host, service in routes:
        if service.startswith("http_status:"):
            cprint(f"PASS {host} -> {service}（catch-all/内置响应）", "green")
            continue
        if host == FALLBACK_ORIGIN:
            # fallback origin 是按业务 Host 分发的本地路由器；直接以
            # origin.v50kkp.eu.org 访问得到 502 属于预期，实际可用性由下方
            # 各业务 hostname 的探测以及辅助链路检查共同验证。
            cprint(
                f"INFO {host} -> {service}（Host 路由器，跳过无业务 Host 的直连探测）",
                "cyan",
            )
            continue
        ok, detail = probe_local_backend(service, timeout=3, host_header=host)
        http_code = backend_status_code(detail)
        gateway_error = http_code is not None and 500 <= http_code <= 599
        service_ok = ok and not gateway_error
        cprint(
            f"{'PASS' if service_ok else 'FAIL'} {host} -> {service}: {detail}",
            "green" if service_ok else "red",
        )
        if not service_ok:
            failures += 1

        ch = custom_by_host.get(host)
        if ch:
            saas_status = ch.get("status") or "-"
            ssl_status = (ch.get("ssl") or {}).get("status") or "-"
            saas_ok = saas_status == "active"
            ssl_ok = ssl_status == "active"
            cprint(
                f"  {'PASS' if saas_ok else 'FAIL'} SaaS={saas_status} ssl={ssl_status}",
                "green" if saas_ok and ssl_ok else "yellow" if saas_ok else "red",
            )
            if not saas_ok:
                failures += 1
            elif not ssl_ok:
                cprint("  WARN 证书仍在签发/部署中", "yellow")
            try:
                zone = resolve_zone(host)
                if zone is None:
                    cprint(
                        "  INFO 域名不在本账号 zone 下，跳过 DNS 检查",
                        "cyan",
                    )
                else:
                    target = get_dns_record_content(zone[1], host, "CNAME")
                    if target in (PREFERRED_ENTRY, FALLBACK_ORIGIN):
                        cprint(f"  PASS DNS CNAME -> {target}", "green")
                    else:
                        cprint(f"  FAIL DNS CNAME -> {target or '(空)'}", "red")
                        failures += 1
            except Exception as exc:
                cprint(f"  FAIL DNS 检查: {exc}", "red")
                failures += 1
        elif not custom_error:
            cprint("  INFO 未登记为 SaaS custom hostname（按普通 Tunnel 规则）", "cyan")

        if include_https:
            https_ok, detail = verify_https(host, timeout=10)
            first_line = next(
                (line.strip() for line in detail.splitlines() if line.startswith("HTTP/")),
                "无 HTTP 状态",
            )
            cprint(
                f"  {'PASS' if https_ok else 'FAIL'} 公网 HTTPS: {first_line}",
                "green" if https_ok else "red",
            )
            if not https_ok:
                failures += 1

    cprint(
        f"\n健康检查结果: {'PASS' if failures == 0 else f'FAIL ({failures} 项)'}",
        "green" if failures == 0 else "red",
    )
    return failures == 0



def switch_to_preferred(hostname: str) -> None:
    zone = resolve_zone(hostname)
    zone_id = zone[1] if zone else None
    if zone_id is None:
        cprint(
            f"{hostname} 不在本账号 zone 下：脚本改不了解析，"
            f"请手动把 CNAME 指到 {PREFERRED_ENTRY}",
            "yellow",
        )
    ch = get_custom_hostname(hostname)
    if not ch:
        raise CFError("该域名还没有 SaaS 自定义主机名，请先走“新增并加速”")
    if ch.get("status") != "active":
        cprint("自定义主机名尚未 Active，先补验证并等待...", "yellow")
        ch = refresh_custom_hostname(ch["id"])
        apply_saas_validation_records(hostname, ch, zone_id)
        if zone_id:
            upsert_dns(zone_id, "CNAME", hostname, FALLBACK_ORIGIN, proxied=False, ttl=60)
        ch = wait_custom_hostname_active(ch["id"], zone_id=zone_id, hostname=hostname)
    if zone_id is None:
        ok, detail = verify_https(hostname)
        cprint(detail)
        cprint(
            f"请确认 DNS: CNAME {hostname} -> {PREFERRED_ENTRY}（结果: {'通' if ok else '未通'}）",
            "green" if ok else "yellow",
        )
        return
    upsert_dns(
        zone_id,
        "CNAME",
        hostname,
        PREFERRED_ENTRY,
        proxied=False,
        ttl=120,
        comment="preferred CF entry via dual-domain saas",
    )
    api_cname = wait_dns_cname(zone_id, hostname, PREFERRED_ENTRY, timeout=90)
    cprint(f"{hostname} 已切换到 {PREFERRED_ENTRY} (API确认: {api_cname})", "green")

