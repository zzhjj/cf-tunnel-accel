def tunnel_routes() -> List[Tuple[str, str]]:
    """当前隧道 ingress 里的 hostname -> service。"""
    try:
        if CONFIG_PATH.exists():
            return parse_ingress_hostnames(CONFIG_PATH.read_text(encoding="utf-8"))
    except Exception:
        return []
    return []


def saas_fallback_map() -> Dict[str, str]:
    """哪些 zone 配了 SaaS fallback origin（正常只有辅助域一个）。"""
    found: Dict[str, str] = {}
    for name, meta in sorted(_zone_info.items()):
        zid = str(meta.get("id") or "")
        if not zid:
            continue
        resp = api("GET", f"/zones/{zid}/custom_hostnames/fallback_origin")
        result = resp.get("result") or {}
        if resp.get("success") and result.get("origin"):
            found[name] = str(result["origin"])
    return found


def saas_quota() -> Optional[dict]:
    resp = api("GET", f"/zones/{AUX_ZONE_ID}/custom_hostnames/quota")
    return resp.get("result") if resp.get("success") else None


def zone_dns_summary(zone_id: str) -> Dict[str, List[str]]:
    """轻量扫描 zone：哪些 CNAME 指向优选/回退源，哪些名字上已有 A/AAAA。"""
    summary: Dict[str, List[str]] = {"entry_cnames": [], "addressed": []}
    for r in list_dns(zone_id):
        rtype = str(r.get("type") or "")
        name = str(r.get("name") or "").lower()
        content = str(r.get("content") or "").rstrip(".")
        if rtype == "CNAME" and content in (PREFERRED_ENTRY, FALLBACK_ORIGIN):
            summary["entry_cnames"].append(name)
        elif rtype in ("A", "AAAA"):
            summary["addressed"].append(f"{rtype} {name}")
    return summary


def build_zone_inventory(
    refresh: bool = True, with_dns: bool = True, offline: bool = False
) -> List[dict]:
    """汇总账号内每个 zone 的可用性，供 domains 命令与新增向导共用。

    offline=True 时完全不发请求，只用本机缓存清单。
    """
    if offline:
        refresh, with_dns = False, False
    if refresh:
        ensure_zone_cache()
    routes = tunnel_routes()
    tunnel_hosts = {host for host, _ in routes}
    ch_by_host: Dict[str, dict] = {}
    quota: Optional[dict] = None
    fallbacks: Dict[str, str] = {}
    if not offline:
        try:
            ch_by_host = {
                str(item.get("hostname") or "").lower(): item
                for item in list_custom_hostnames()
            }
        except Exception as exc:
            cprint(f"警告: 读取 SaaS 自定义主机名失败: {exc}", "yellow")
        try:
            quota = saas_quota()
        except Exception:
            quota = None
        try:
            fallbacks = saas_fallback_map()
        except Exception:
            fallbacks = {}
    quota_exceeded = bool((quota or {}).get("exceeded"))

    rows: List[dict] = []
    for name, meta in sorted(_zone_info.items()):
        zid = str(meta.get("id") or "")
        status = str(meta.get("status") or "unknown")
        ztype = str(meta.get("type") or "unknown")
        reasons: List[str] = []
        usable = True
        if status != "active":
            usable = False
            reasons.append(f"status={status}，域名还没在 Cloudflare 激活")
        if meta.get("paused"):
            usable = False
            reasons.append("zone 已暂停 paused")
        if ztype not in ("full", "unknown"):
            reasons.append(f"type={ztype}（CNAME 接入），部分记录不受本账号控制")
        if quota_exceeded:
            usable = False
            reasons.append("SaaS 自定义主机名配额已用尽")
        in_zone = sorted(
            host
            for host in set(ch_by_host) | tunnel_hosts
            if zone_of_host(host) == name
        )
        entry_cnames = in_zone
        addressed: List[str] = []
        if with_dns and zid:
            try:
                summary = zone_dns_summary(zid)
            except Exception as exc:
                cprint(f"警告: 读取 {name} 的 DNS 失败: {exc}", "yellow")
                summary = {"entry_cnames": [], "addressed": []}
            entry_cnames = sorted(set(summary["entry_cnames"]) | set(in_zone))
            addressed = summary["addressed"]
        rows.append(
            {
                "name": name,
                "id": zid,
                "status": status,
                "type": ztype,
                "plan": str(meta.get("plan") or "unknown"),
                "usable": usable,
                "reasons": reasons,
                "is_aux": name in fallbacks or zid == AUX_ZONE_ID,
                "fallback_origin": fallbacks.get(name)
                or (FALLBACK_ORIGIN if zid == AUX_ZONE_ID else None),
                "hostnames": entry_cnames,
                "saas": sorted(h for h in in_zone if h in ch_by_host),
                "tunnel": sorted(h for h in in_zone if h in tunnel_hosts),
                "addressed": addressed,
                "cached": bool(meta.get("cached")),
            }
        )
    return rows


def _shorten(names: List[str], limit: int = 8) -> str:
    if not names:
        return "-"
    head = ", ".join(names[:limit])
    return f"{head} 等 {len(names)} 个" if len(names) > limit else head


def print_domains(show_dns: bool = True, offline: bool = False) -> int:
    """回答“我到底有哪些域名可以用”。"""
    if offline:
        load_zone_cache_file()
    rows = build_zone_inventory(
        refresh=not offline,
        with_dns=show_dns and not offline,
        offline=offline,
    )
    if not rows:
        cprint("没有读到任何 zone；请确认 Token 有效（权限需要 Zone:Read）。", "red")
        return 1
    width = max(len(r["name"]) for r in rows)
    tail = "（离线，仅本机缓存）" if offline else f"（清单更新于 {zone_cache_age_text()}）"
    cprint(f"\n====== 账号可用域名：{len(rows)} 个 zone {tail} ======", "bold")
    cprint(f"  #   {'域名'.ljust(width)}  状态    接入  已加速  判定")
    for idx, r in enumerate(rows, start=1):
        if r["is_aux"]:
            tag = "辅助域" if r["name"] == AUX_ZONE_NAME else "额外辅助域"
        else:
            tag = "业务域"
        used = f"{len(r['hostnames']):>3}"
        if r["usable"]:
            cprint(
                f"  {idx:<3} {r['name'].ljust(width)}  {r['status']:<7} {r['type']:<5} {used}  "
                f" ✓ 可用（{tag}）",
                "green",
            )
            for warn in r["reasons"]:
                cprint(f"        - 注意: {warn}", "yellow")
        else:
            cprint(
                f"  {idx:<3} {r['name'].ljust(width)}  {r['status']:<7} {r['type']:<5} {used}  "
                f" ✗ 不可用（{tag}）：" + "；".join(r["reasons"]),
                "red",
            )
        if r["addressed"]:
            cprint(f"        已有 A/AAAA（新增同名子域时会冲突）: {_shorten(r['addressed'], 3)}", "cyan")

    cprint("\n====== 已加速主机名（按 zone 归类）======", "bold")
    unused_rows: List[dict] = []
    for r in rows:
        if not r["hostnames"]:
            unused_rows.append(r)
