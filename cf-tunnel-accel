    resp = api("GET", "/user/tokens/verify")
    if not resp.get("success"):
        raise CFError(
            f"API Token 无效: {resp.get('errors')}\n"
            "确认 Token 未过期，且含 Zone:Read / DNS:Edit / SSL and Certificates:Edit 权限"
        )
    cprint("API Token 验证通过", "green")
    first_run = not _zone_info
    refresh_zone_cache()
    if first_run and _zone_info:
        names = sorted(_zone_info)
        head = ", ".join(names[:8])
        more = f" 等 {len(names)} 个" if len(names) > 8 else ""
        cprint(f"账号里可用域名: {head}{more}", "cyan")
