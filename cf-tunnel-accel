def list_dns(zone_id: str, name: Optional[str] = None) -> List[dict]:
    items: List[dict] = []
    page = 1
    while True:
        q = f"/zones/{zone_id}/dns_records?per_page=100&page={page}"
        if name:
            q += f"&name={urllib.parse.quote(name, safe='')}"
        resp = api_ok(api("GET", q), "读取 DNS")
        batch = resp.get("result") or []
        items.extend(batch)
        info = resp.get("result_info") or {}
        total_pages = int(info.get("total_pages") or 1)
        if page >= total_pages or not batch:
            break
        page += 1
    return items


def upsert_dns(
    zone_id: str,
    rtype: str,
    name: str,
    content: str,
    proxied: Optional[bool] = None,
    ttl: int = 120,
    comment: str = "",
) -> dict:
    recs = list_dns(zone_id, name)
    body: Dict[str, Any] = {
        "type": rtype,
        "name": name,
        "content": content,
        "ttl": 1 if proxied else ttl,
    }
    if proxied is not None and rtype in ("A", "AAAA", "CNAME"):
        body["proxied"] = proxied
    if comment:
        body["comment"] = comment

    # CNAME 与同名其它类型冲突时，清掉冲突项
    if rtype == "CNAME":
        for o in recs:
            if o["type"] != "CNAME":
                api_ok(
                    api("DELETE", f"/zones/{zone_id}/dns_records/{o['id']}"),
                    f"删除冲突记录 {o['type']} {o['name']}",
                )
        recs = [r for r in recs if r["type"] == "CNAME"]

    same = [r for r in recs if r["type"] == rtype]
    if rtype == "TXT" and same:
        for s in same:
            cur = s["content"].strip('"')
            if cur == content or s["content"] == content:
                return s
        # 同名 TXT 可以合法存在多条；新增验证值，不覆盖 SPF/旧验证值。
        return api_ok(
            api("POST", f"/zones/{zone_id}/dns_records", body),
            f"创建 TXT {name}",
        )["result"]

    if same:
        current = same[0]
        content_same = str(current.get("content", "")).rstrip(".") == content.rstrip(".")
        proxy_same = (
            proxied is None
            or rtype not in ("A", "AAAA", "CNAME")
            or bool(current.get("proxied")) == proxied
        )
        if content_same and proxy_same:
            return current
        rid = same[0]["id"]
        return api_ok(
            api("PUT", f"/zones/{zone_id}/dns_records/{rid}", body),
            f"更新 {rtype} {name}",
        )["result"]

    return api_ok(
        api("POST", f"/zones/{zone_id}/dns_records", body),
        f"创建 {rtype} {name}",
    )["result"]


def delete_dns_name(zone_id: str, name: str, types: Optional[List[str]] = None) -> int:
    recs = list_dns(zone_id, name)
    n = 0
    for r in recs:
        if types and r["type"] not in types:
            continue
        api_ok(api("DELETE", f"/zones/{zone_id}/dns_records/{r['id']}"), f"删除 {r['type']} {name}")
        n += 1
    return n


