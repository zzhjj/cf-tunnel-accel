def cprint(msg: str = "", color: Optional[str] = None) -> None:
    colors = {
        "red": "\033[31m",
        "green": "\033[32m",
        "yellow": "\033[33m",
        "blue": "\033[34m",
        "cyan": "\033[36m",
        "bold": "\033[1m",
        "reset": "\033[0m",
    }
    if color and sys.stdout.isatty():
        print(f"{colors.get(color, '')}{msg}{colors['reset']}", flush=True)
    else:
        print(msg, flush=True)


def prompt(text: str, default: Optional[str] = None) -> str:
    suffix = f" [{default}]" if default is not None else ""
    while True:
        val = input(f"{text}{suffix}: ").strip()
        if not val and default is not None:
            return default
        if val:
            return val
        cprint("不能为空，请重新输入。", "yellow")


def prompt_yes_no(text: str, default: bool = True) -> bool:
    tip = "Y/n" if default else "y/N"
    while True:
        val = input(f"{text} [{tip}]: ").strip().lower()
        if not val:
            return default
        if val in ("y", "yes", "是"):
            return True
        if val in ("n", "no", "否"):
            return False
        cprint("请输入 y 或 n。", "yellow")


def read_line(text: str) -> Optional[str]:
    """读一行输入；stdin 结束时按“取消”处理，而不是抛 EOF 栈。"""
    try:
        return input(text)
    except EOFError:
        print()
        return None

def _retry_delay(attempt: int, retry_after: Optional[str] = None) -> float:
    try:
        if retry_after is not None:
            return min(API_RETRY_MAX_WAIT, max(0.1, float(retry_after)))
    except ValueError:
        pass
    return min(API_RETRY_MAX_WAIT, float(2 ** (attempt - 1)))


def _can_retry_api(method: str, status: Optional[int] = None) -> bool:
    """仅重试幂等请求，避免 POST 超时后意外创建重复资源。"""
    if method.upper() not in {"GET", "PUT", "DELETE"}:
        return False
    return status is None or status == 429 or 500 <= status <= 599


def api(method: str, path: str, body: Optional[dict] = None, timeout: int = 45) -> dict:
    if not CF_API_TOKEN:
        return {
            "success": False,
            "errors": [{
                "code": "token_missing",
                "message": (
                    "未找到 API Token；请设置 CF_TUNNEL_ACCEL_API_TOKEN / CF_API_TOKEN，"
                    f"或写入 {TOKEN_FILE}"
                ),
            }],
        }
    url = path if path.startswith("http") else f"{API_BASE}{path}"
    data = None if body is None else json.dumps(body).encode("utf-8")
    for attempt in range(1, API_RETRY_ATTEMPTS + 1):
        req = urllib.request.Request(
            url,
            data=data,
            method=method,
            headers={
                "Authorization": f"Bearer {CF_API_TOKEN}",
                "Content-Type": "application/json",
                "User-Agent": f"cf-tunnel-accel/{SCRIPT_VERSION}",
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return json.loads(resp.read().decode() or "{}")
        except urllib.error.HTTPError as e:
            raw = e.read().decode(errors="replace")
            try:
                payload = json.loads(raw)
            except Exception:
                payload = {"success": False, "errors": [{"message": raw}], "status": e.code}
            if attempt < API_RETRY_ATTEMPTS and _can_retry_api(method, e.code):
                delay = _retry_delay(attempt, e.headers.get("Retry-After") if e.headers else None)
                cprint(
                    f"Cloudflare API HTTP {e.code}，{delay:.1f}s 后重试 "
                    f"({attempt}/{API_RETRY_ATTEMPTS - 1})...",
                    "yellow",
                )
                time.sleep(delay)
                continue
            return payload
        except Exception as e:
            if attempt < API_RETRY_ATTEMPTS and _can_retry_api(method):
                delay = _retry_delay(attempt)
                cprint(
                    f"Cloudflare API 网络错误: {e}；{delay:.1f}s 后重试 "
                    f"({attempt}/{API_RETRY_ATTEMPTS - 1})...",
                    "yellow",
                )
                time.sleep(delay)
                continue
            return {"success": False, "errors": [{"message": str(e)}]}
    return {"success": False, "errors": [{"message": "API 重试耗尽"}]}


def api_ok(resp: dict, action: str = "API") -> dict:
    if resp.get("success"):
        return resp
    errs = resp.get("errors") or [{"message": "unknown error"}]
    msg = "; ".join(
        f"[{e.get('code','?')}] {e.get('message', e)}" if isinstance(e, dict) else str(e)
        for e in errs
    )
    raise CFError(f"{action} 失败: {msg}")


def run(
    cmd: List[str], check: bool = True, timeout: Optional[float] = 60
) -> subprocess.CompletedProcess:
    try:
        p = subprocess.run(cmd, text=True, capture_output=True, timeout=timeout)
    except FileNotFoundError:
        raise CFError(f"未找到命令: {cmd[0]}") from None
    except subprocess.TimeoutExpired:
        raise CFError(f"命令超时（{timeout}s）: {' '.join(cmd)}") from None
    if check and p.returncode != 0:
        raise CFError(
            f"命令失败: {' '.join(cmd)}\nstdout: {p.stdout}\nstderr: {p.stderr}"
        )
    return p


@contextmanager
def exclusive_lock() -> Any:
    """阻止多个脚本实例同时修改 DNS、SaaS 或 Tunnel 配置。"""
    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    with LOCK_PATH.open("a+", encoding="utf-8") as lock_file:
        try:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            lock_file.seek(0)
            holder = lock_file.read().strip() or "未知进程"
            raise CFError(f"已有 cf-tunnel-accel 实例正在运行（{holder}）") from None
        lock_file.seek(0)
        lock_file.truncate()
        lock_file.write(f"pid={os.getpid()} started={datetime.now().isoformat(timespec='seconds')}\n")
        lock_file.flush()
        try:
            yield
        finally:
            lock_file.seek(0)
            lock_file.truncate()
            lock_file.flush()
            os.fsync(lock_file.fileno())
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)


